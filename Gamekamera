<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kuis Gerak Kamera Interaktif (A vs B)</title>
    <!-- Menggunakan Google Fonts Poppins & Inter untuk keterbacaan optimal dari jarak jauh -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Poppins', 'Inter', 'sans-serif'],
                    },
                    animation: {
                        'pop-in': 'popIn 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
                        'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        popIn: {
                            '0%': { opacity: '0', transform: 'scale(0.6) translateY(20px)' },
                            '100%': { opacity: '1', transform: 'scale(1) translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Efek cermin (Mirror mode) pada kamera agar gerakan pemain natural */
        .mirror-video {
            transform: scaleX(-1);
            -webkit-transform: scaleX(-1);
        }

        /* Custom Scrollbar untuk daftar soal di Setup Screen */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.5);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.6);
            border-radius: 8px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.9);
        }

        /* Mencegah pemilihan teks saat bermain */
        .no-select {
            user-select: none;
            -webkit-user-select: none;
        }

        /* Bayangan teks kuat agar tetap kontras di atas video kamera cerah */
        .text-stroke-shadow {
            text-shadow: 0 4px 16px rgba(0, 0, 0, 0.85), 0 2px 4px rgba(0, 0, 0, 0.95);
        }
    </style>
</head>
<body class="bg-slate-950 text-white font-sans antialiased overflow-x-hidden selection:bg-indigo-500 selection:text-white">

    <!-- =====================================================================
         NOTIFIKASI TOAST (PENGGANTI ALERT)
    ====================================================================== -->
    <div id="toast-container" class="fixed top-5 right-5 z-[100] flex flex-col gap-3 pointer-events-none max-w-sm w-full px-4 sm:px-0"></div>

    <!-- =====================================================================
         LAYAR 1: PENGATURAN AWAL (SETUP SCREEN)
    ====================================================================== -->
    <section id="setup-screen" class="min-h-screen w-full bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950 py-6 px-4 sm:px-8 flex flex-col items-center">
        <div class="w-full max-w-5xl">
            <!-- Header Setup -->
            <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-bold uppercase tracking-wider mb-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                        Mode Interaktif Kamera (WebRTC)
                    </div>
                    <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-white">
                        Kuis Gerak <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Zona A vs Zona B</span>
                    </h1>
                    <p class="text-slate-400 text-sm sm:text-base mt-1">
                        Pemain bergerak ke sisi kiri (A) atau kanan (B) layar kamera untuk menjawab soal secara fisik!
                    </p>
                </div>

                <!-- Tombol Mulai Game Utama -->
                <button id="btn-start-game" onclick="startGame()" class="group relative inline-flex items-center justify-center gap-3 px-7 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-extrabold text-lg shadow-lg shadow-emerald-900/40 transition-all duration-200 active:scale-95 cursor-pointer shrink-0">
                    <svg class="w-6 h-6 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    <span>Mulai Game</span>
                </button>
            </header>

            <!-- Grid Pengaturan & Bank Soal -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6">
                
                <!-- Kolom Kiri (5 Kolom): Pengaturan Timer & Form Tambah Soal -->
                <div class="lg:col-span-5 flex flex-col gap-6">
                    
                    <!-- Kartu Pengaturan Timer & Kamera -->
                    <div class="bg-slate-900/80 backdrop-blur-md border border-slate-800 rounded-2xl p-5 shadow-xl">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-4">
                            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Pengaturan Permainan
                        </h2>

                        <label class="block text-sm font-semibold text-slate-300 mb-2">Durasi Timer per Soal:</label>
                        <div class="grid grid-cols-4 gap-2 mb-3">
                            <button type="button" onclick="setTimerPreset(5)" class="timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-slate-700 bg-slate-800/70 hover:bg-indigo-600/30 hover:border-indigo-500 transition cursor-pointer" data-sec="5">5 Detik</button>
                            <button type="button" onclick="setTimerPreset(10)" class="timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-indigo-500 bg-indigo-600 text-white transition cursor-pointer" data-sec="10">10 Detik</button>
                            <button type="button" onclick="setTimerPreset(15)" class="timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-slate-700 bg-slate-800/70 hover:bg-indigo-600/30 hover:border-indigo-500 transition cursor-pointer" data-sec="15">15 Detik</button>
                            <button type="button" onclick="setTimerPreset(20)" class="timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-slate-700 bg-slate-800/70 hover:bg-indigo-600/30 hover:border-indigo-500 transition cursor-pointer" data-sec="20">20 Detik</button>
                        </div>
                        <div class="flex items-center gap-3 mt-3">
                            <span class="text-xs text-slate-400">Atau kustom (detik):</span>
                            <input type="number" id="custom-timer" min="3" max="60" value="10" onchange="syncCustomTimer(this.value)" class="w-24 px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-700 text-white font-bold text-center focus:outline-none focus:border-indigo-500">
                        </div>

                        <div class="mt-4 pt-4 border-t border-slate-800 flex items-center justify-between">
                            <div>
                                <p class="text-sm font-semibold text-slate-200">Efek Suara (Web Audio)</p>
                                <p class="text-xs text-slate-400">Detak waktu & lonceng jawaban</p>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="toggle-sound" checked class="sr-only peer">
                                <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                            </label>
                        </div>
                    </div>

                    <!-- Kartu Tambah Soal Baru -->
                    <div class="bg-slate-900/80 backdrop-blur-md border border-slate-800 rounded-2xl p-5 shadow-xl">
                        <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-4">
                            <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            Tambah Soal Baru
                        </h2>
                        <form id="add-question-form" onsubmit="handleAddQuestion(event)" class="flex flex-col gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-400 uppercase mb-1">Pertanyaan</label>
                                <input type="text" id="input-q" required placeholder="Contoh: Apa kepanjangan dari CPU?" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500">
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-blue-400 uppercase mb-1">Opsi A (Kiri Layar)</label>
                                    <input type="text" id="input-a" required placeholder="Pilihan A..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-amber-400 uppercase mb-1">Opsi B (Kanan Layar)</label>
                                    <input type="text" id="input-b" required placeholder="Pilihan B..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500">
                                </div>
                            </div>
                            <div class="flex items-center justify-between gap-3 pt-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-semibold text-slate-300">Kunci Jawaban:</span>
                                    <select id="input-ans" class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-700 text-sm font-bold text-emerald-400 focus:outline-none focus:border-emerald-500 cursor-pointer">
                                        <option value="A">A (Kiri)</option>
                                        <option value="B">B (Kanan)</option>
                                    </select>
                                </div>
                                <button type="submit" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition active:scale-95 cursor-pointer">
                                    + Tambah Soal
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Kolom Kanan (7 Kolom): Daftar Soal Aktif -->
                <div class="lg:col-span-7 bg-slate-900/80 backdrop-blur-md border border-slate-800 rounded-2xl p-5 shadow-xl flex flex-col">
                    <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-800">
                        <div>
                            <h2 class="text-lg font-bold text-white">Daftar Soal Kuis (<span id="question-count" class="text-indigo-400">8</span> Soal)</h2>
                            <p class="text-xs text-slate-400">Soal di bawah ini akan dimainkan secara berurutan.</p>
                        </div>
                        <button type="button" onclick="resetDefaultQuestions()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold border border-slate-700 transition cursor-pointer">
                            Reset Soal Bawaan
                        </button>
                    </div>

                    <!-- Container List Soal -->
                    <div id="questions-list" class="mt-4 flex flex-col gap-3 max-h-[460px] overflow-y-auto pr-1">
                        <!-- Diisi secara dinamis oleh JS -->
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- =====================================================================
         LAYAR 2: GAMEPLAY UI (FULLSCREEN INTERAKTIF KAMERA)
    ====================================================================== -->
    <main id="gameplay-screen" class="hidden fixed inset-0 w-screen h-screen bg-black overflow-hidden no-select z-50">
        
        <!-- LAYER 1: Live Feed Kamera (Mirror Mode / Terbalik Horizontal) -->
        <video id="webcam-video" autoplay playsinline muted class="absolute inset-0 w-full h-full object-cover mirror-video"></video>

        <!-- Fallback jika kamera gagal atau mode simulasi -->
        <div id="camera-fallback-bg" class="hidden absolute inset-0 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 flex items-center justify-center">
            <p class="text-slate-500 text-sm font-medium">Mode Tanpa Kamera (Simulasi Layar)</p>
        </div>

        <!-- LAYER 2: Pembagi Tengah Layar (50% Kiri Zona A | 50% Kanan Zona B) -->
        <div class="absolute inset-0 pointer-events-none flex">
            <!-- Zona Kiri (A) Overlay Hasil -->
            <div id="zone-overlay-a" class="w-1/2 h-full transition-colors duration-300 flex items-center justify-center"></div>
            
            <!-- Garis Vertikal Tipis Tepat di Tengah Layar -->
            <div class="w-[3px] h-full bg-white/80 shadow-[0_0_15px_rgba(255,255,255,0.9)] z-10"></div>
            
            <!-- Zona Kanan (B) Overlay Hasil -->
            <div id="zone-overlay-b" class="w-1/2 h-full transition-colors duration-300 flex items-center justify-center"></div>
        </div>

        <!-- LAYER 3: Pengungkapan Jawaban Tengah Layar (Fase 2) -->
        <div id="reveal-banner" class="hidden absolute inset-0 z-30 pointer-events-none flex flex-col items-center justify-center px-4">
            <div class="bg-slate-950/90 border-4 border-white px-8 py-6 sm:px-14 sm:py-8 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] text-center animate-pop-in">
                <p class="text-emerald-400 font-extrabold text-lg sm:text-2xl uppercase tracking-widest mb-1">Kunci Jawaban</p>
                <h2 id="reveal-answer-text" class="text-5xl sm:text-7xl md:text-8xl font-black text-white tracking-tight">
                    JAWABAN: A
                </h2>
                <p id="reveal-answer-desc" class="text-slate-200 font-bold text-xl sm:text-3xl mt-3 max-w-2xl">
                    Central Processing Unit
                </p>
            </div>
        </div>

        <!-- LAYER 4: Header Atas (Timer Kiri Atas & Kotak Pertanyaan Tengah Atas) -->
        <header class="absolute top-0 left-0 right-0 z-20 p-3 sm:p-6 flex items-start justify-between gap-3 sm:gap-6 pointer-events-none">
            
            <!-- Pojok Kiri Atas: Lingkaran Indikator Countdown Timer -->
            <div class="flex flex-col items-center shrink-0">
                <div id="timer-circle" class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-slate-950/90 border-4 border-emerald-400 shadow-[0_8px_30px_rgba(0,0,0,0.7)] flex items-center justify-center transition-colors duration-300">
                    <span id="timer-text" class="text-3xl sm:text-5xl font-black text-white tabular-nums">10</span>
                </div>
                <span id="question-progress" class="mt-1.5 px-2.5 py-0.5 rounded-full bg-black/75 text-white text-xs sm:text-sm font-bold border border-white/20">
                    Soal 1/8
                </span>
            </div>

            <!-- Tengah Atas: Kotak Putih Membulat Berisi Teks Pertanyaan -->
            <div class="flex-1 max-w-4xl mx-auto bg-white/95 backdrop-blur-md text-slate-950 rounded-2xl sm:rounded-3xl px-5 py-4 sm:px-8 sm:py-6 shadow-[0_12px_40px_rgba(0,0,0,0.65)] border-2 border-slate-200 text-center">
                <p id="gameplay-question-text" class="text-lg sm:text-2xl md:text-3xl lg:text-4xl font-extrabold leading-snug tracking-tight text-slate-900">
                    Memuat pertanyaan...
                </p>
            </div>

            <!-- Pojok Kanan Atas: Tombol Keluar / Berhenti Darurat (Pointer Events Auto) -->
            <div class="shrink-0 pointer-events-auto">
                <button onclick="exitToSetup()" title="Keluar ke Pengaturan" class="w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-slate-950/80 hover:bg-rose-600 text-white border border-white/20 flex items-center justify-center shadow-lg transition cursor-pointer">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </header>

        <!-- LAYER 5: Footer Bawah (Opsi A Kiri, Status AKTIF Tengah, Opsi B Kanan) -->
        <footer class="absolute bottom-0 left-0 right-0 z-20 p-3 sm:p-6 flex flex-col md:flex-row items-center md:items-end justify-between gap-3 sm:gap-4 pointer-events-none">
            
            <!-- Pojok Kiri Bawah: Badge Huruf A & Teks Pilihan A -->
            <div id="badge-option-a" class="w-full md:w-[40%] bg-slate-950/90 backdrop-blur-md border-2 border-blue-400/80 rounded-2xl sm:rounded-3xl p-3 sm:p-4 flex items-center gap-3 sm:gap-4 shadow-[0_10px_30px_rgba(0,0,0,0.8)] transition-transform duration-300">
                <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 text-white font-black text-2xl sm:text-4xl flex items-center justify-center shrink-0 shadow-inner">
                    A
                </div>
                <div class="flex-1 min-w-0">
                    <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-blue-300">Sisi Kiri Layar</span>
                    <p id="gameplay-option-a" class="text-base sm:text-xl md:text-2xl font-extrabold text-white leading-tight break-words">
                        Pilihan A
                    </p>
                </div>
            </div>

            <!-- Tengah Bawah: Bar Indikator Status Berwarna Hijau Bertuliskan "AKTIF" -->
            <div class="shrink-0 order-first md:order-none mb-1 md:mb-2">
                <div id="status-bar" class="px-6 py-2 sm:px-8 sm:py-3 rounded-full bg-emerald-600 border-2 border-emerald-300 shadow-[0_0_25px_rgba(16,185,129,0.7)] flex items-center gap-2.5 transition-all duration-300">
                    <span id="status-dot" class="w-3 h-3 rounded-full bg-white animate-ping"></span>
                    <span id="status-text" class="text-sm sm:text-lg font-black tracking-widest text-white uppercase">
                        AKTIF
                    </span>
                </div>
            </div>

            <!-- Pojok Kanan Bawah: Badge Huruf B & Teks Pilihan B -->
            <div id="badge-option-b" class="w-full md:w-[40%] bg-slate-950/90 backdrop-blur-md border-2 border-amber-400/80 rounded-2xl sm:rounded-3xl p-3 sm:p-4 flex items-center justify-end gap-3 sm:gap-4 shadow-[0_10px_30px_rgba(0,0,0,0.8)] text-right transition-transform duration-300">
                <div class="flex-1 min-w-0">
                    <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-amber-300">Sisi Kanan Layar</span>
                    <p id="gameplay-option-b" class="text-base sm:text-xl md:text-2xl font-extrabold text-white leading-tight break-words">
                        Pilihan B
                    </p>
                </div>
                <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-xl sm:rounded-2xl bg-gradient-to-br from-amber-500 to-orange-600 text-white font-black text-2xl sm:text-4xl flex items-center justify-center shrink-0 shadow-inner">
                    B
                </div>
            </div>

        </footer>
    </main>

    <!-- =====================================================================
         LAYAR 3: LAYAR SELESAI (GAME OVER / PEMENANG)
    ====================================================================== -->
    <section id="gameover-screen" class="hidden fixed inset-0 w-screen h-screen bg-slate-950/95 backdrop-blur-xl z-50 flex flex-col items-center justify-center p-6 text-center">
        <div class="max-w-2xl w-full bg-slate-900 border border-slate-800 rounded-3xl p-8 sm:p-12 shadow-2xl animate-pop-in">
            <!-- Ikon Piala SVG -->
            <div class="w-24 h-24 mx-auto mb-6 rounded-3xl bg-gradient-to-br from-amber-400 to-orange-600 flex items-center justify-center shadow-lg shadow-amber-500/30">
                <svg class="w-14 h-14 text-white" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z"/>
                </svg>
            </div>

            <span class="inline-block px-4 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 font-bold text-sm uppercase tracking-wider mb-3">
                Permainan Selesai!
            </span>

            <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
                Selamat Kepada Para Pemenang!
            </h2>

            <p class="text-slate-300 text-base sm:text-xl leading-relaxed mb-8">
                Luar biasa! Bagi peserta yang berhasil bertahan di zona hijau hingga soal terakhir, kalian adalah juaranya!
            </p>

            <!-- Tombol Aksi Akhir -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button onclick="restartGame()" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-extrabold text-lg shadow-lg transition active:scale-95 cursor-pointer flex items-center justify-center gap-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    <span>Main Lagi</span>
                </button>

                <button onclick="exitToSetup()" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-lg border border-slate-700 transition active:scale-95 cursor-pointer flex items-center justify-center gap-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Kembali ke Pengaturan</span>
                </button>
            </div>
        </div>
    </section>

    <!-- =====================================================================
         JAVASCRIPT LOGIC: STATE MACHINE, WEBRTC KAMERA & WEB AUDIO API
    ====================================================================== -->
    <script>
        /**
         * 1. DATA SOAL BAWAAN (PENGETAHUAN UMUM & TIK)
         */
        const DEFAULT_QUESTIONS = [
            {
                question: "Apa kepanjangan dari CPU pada komputer?",
                optionA: "Central Processing Unit",
                optionB: "Control Power Utility",
                answer: "A"
            },
            {
                question: "Perangkat lunak yang berfungsi sebagai jembatan antara hardware dan pengguna adalah...",
                optionA: "Browser Web",
                optionB: "Sistem Operasi (OS)",
                answer: "B"
            },
            {
                question: "Manakah yang merupakan bahasa pemrograman untuk membuat struktur halaman web?",
                optionA: "HTML",
                optionB: "Photoshop",
                answer: "A"
            },
            {
                question: "Ibu kota negara Jepang adalah...",
                optionA: "Seoul",
                optionB: "Tokyo",
                answer: "B"
            },
            {
                question: "Memori sementara pada komputer yang datanya hilang saat listrik mati disebut...",
                optionA: "RAM",
                optionB: "Harddisk / SSD",
                answer: "A"
            },
            {
                question: "Planet terbesar di tata surya kita adalah...",
                optionA: "Saturnus",
                optionB: "Jupiter",
                answer: "B"
            },
            {
                question: "Tombol pintasan (shortcut) pada keyboard untuk menyalin teks adalah...",
                optionA: "Ctrl + C",
                optionB: "Ctrl + V",
                answer: "A"
            },
            {
                question: "Protokol keamanan pada alamat website yang menggunakan enkripsi ditandai dengan...",
                optionA: "HTTP://",
                optionB: "HTTPS://",
                answer: "B"
            }
        ];

        /**
         * 2. STATE GLOBAL APLIKASI
         */
        let questions = JSON.parse(localStorage.getItem('cam_quiz_questions')) || [...DEFAULT_QUESTIONS];
        let durationPerQuestion = 10; // detik
        let currentQuestionIndex = 0;
        let timeLeft = 10;
        let gameState = 'SETUP'; // 'SETUP' | 'CHOOSING' | 'REVEAL' | 'GAMEOVER'
        
        let countdownInterval = null;
        let revealTimeout = null;
        let mediaStream = null;
        let audioCtx = null;

        /**
         * 3. SISTEM AUDIO SINTESIS (WEB AUDIO API TANPA FILE EKSTERNAL)
         */
        function initAudioContext() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function isSoundEnabled() {
            return document.getElementById('toggle-sound').checked;
        }

        // Efek suara detak waktu (ticking sound) setiap detik
        function playTickSound(isUrgent = false) {
            if (!isSoundEnabled()) return;
            try {
                initAudioContext();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                osc.type = isUrgent ? 'triangle' : 'sine';
                osc.frequency.setValueAtTime(isUrgent ? 980 : 720, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(isUrgent ? 450 : 300, audioCtx.currentTime + 0.08);
                
                gain.gain.setValueAtTime(isUrgent ? 0.35 : 0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.09);
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                osc.start();
                osc.stop(audioCtx.currentTime + 0.09);
            } catch (e) {
                console.warn('Audio error:', e);
            }
        }

        // Efek suara lonceng / fanfare saat kunci jawaban diungkap
        function playRevealBellSound() {
            if (!isSoundEnabled()) return;
            try {
                initAudioContext();
                const notes = [523.25, 659.25, 783.99, 1046.50]; // Nada C5, E5, G5, C6 (Arpeggio Mayor)
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    
                    const startTime = audioCtx.currentTime + (idx * 0.08);
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, startTime);
                    
                    gain.gain.setValueAtTime(0.28, startTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.55);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start(startTime);
                    osc.stop(startTime + 0.55);
                });
            } catch (e) {
                console.warn('Audio error:', e);
            }
        }

        // Efek suara kemenangan akhir (Game Over Fanfare)
        function playVictoryFanfare() {
            if (!isSoundEnabled()) return;
            try {
                initAudioContext();
                const melody = [
                    { f: 523.25, t: 0, d: 0.15 },
                    { f: 659.25, t: 0.15, d: 0.15 },
                    { f: 783.99, t: 0.30, d: 0.15 },
                    { f: 1046.50, t: 0.48, d: 0.65 }
                ];
                melody.forEach(note => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    const start = audioCtx.currentTime + note.t;
                    
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(note.f, start);
                    
                    gain.gain.setValueAtTime(0.32, start);
                    gain.gain.exponentialRampToValueAtTime(0.001, start + note.d);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start(start);
                    osc.stop(start + note.d);
                });
            } catch (e) {
                console.warn('Audio error:', e);
            }
        }

        /**
         * 4. NOTIFIKASI UI (PENGGANTI ALERT)
         */
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const colors = {
                info: 'bg-slate-800 border-indigo-500 text-white',
                success: 'bg-emerald-950/95 border-emerald-500 text-emerald-100',
                error: 'bg-rose-950/95 border-rose-500 text-rose-100'
            };

            toast.className = `pointer-events-auto px-4 py-3 rounded-2xl border shadow-xl text-sm font-semibold flex items-center justify-between gap-3 transition-all duration-300 ${colors[type] || colors.info}`;
            toast.innerHTML = `<span>${message}</span>`;
            
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        /**
         * 5. LOGIKA SETUP SCREEN (TIMER & MANAJEMEN SOAL)
         */
        function setTimerPreset(seconds) {
            durationPerQuestion = seconds;
            document.getElementById('custom-timer').value = seconds;
            
            document.querySelectorAll('.timer-preset-btn').forEach(btn => {
                const btnSec = parseInt(btn.getAttribute('data-sec'), 10);
                if (btnSec === seconds) {
                    btn.className = 'timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-indigo-500 bg-indigo-600 text-white transition cursor-pointer';
                } else {
                    btn.className = 'timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-slate-700 bg-slate-800/70 hover:bg-indigo-600/30 hover:border-indigo-500 text-slate-200 transition cursor-pointer';
                }
            });
        }

        function syncCustomTimer(val) {
            let parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed < 3) parsed = 3;
            if (parsed > 60) parsed = 60;
            durationPerQuestion = parsed;
            document.getElementById('custom-timer').value = parsed;
            
            document.querySelectorAll('.timer-preset-btn').forEach(btn => {
                const btnSec = parseInt(btn.getAttribute('data-sec'), 10);
                if (btnSec === parsed) {
                    btn.className = 'timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-indigo-500 bg-indigo-600 text-white transition cursor-pointer';
                } else {
                    btn.className = 'timer-preset-btn py-2.5 rounded-xl font-bold text-sm border border-slate-700 bg-slate-800/70 hover:bg-indigo-600/30 hover:border-indigo-500 text-slate-200 transition cursor-pointer';
                }
            });
        }

        function saveQuestionsToStorage() {
            localStorage.setItem('cam_quiz_questions', JSON.stringify(questions));
        }

        function renderQuestionsList() {
            const listEl = document.getElementById('questions-list');
            const countEl = document.getElementById('question-count');
            countEl.textContent = questions.length;

            if (questions.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-10 px-4 border-2 border-dashed border-slate-800 rounded-2xl">
                        <p class="text-slate-400 font-semibold">Belum ada soal kuis.</p>
                        <p class="text-xs text-slate-500 mt-1">Tambahkan soal baru melalui formulir di samping atau klik "Reset Soal Bawaan".</p>
                    </div>
                `;
                return;
            }

            listEl.innerHTML = questions.map((item, idx) => `
                <div class="bg-slate-950/80 border border-slate-800 hover:border-slate-700 rounded-2xl p-4 flex items-start justify-between gap-3 transition">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="px-2 py-0.5 rounded-md bg-indigo-500/20 text-indigo-300 text-xs font-extrabold">#${idx + 1}</span>
                            <span class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 text-xs font-bold">Kunci: ${item.answer}</span>
                        </div>
                        <p class="text-sm sm:text-base font-bold text-white mb-2">${escapeHTML(item.question)}</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                            <div class="px-3 py-1.5 rounded-lg ${item.answer === 'A' ? 'bg-emerald-950/60 border border-emerald-500/40 text-emerald-200' : 'bg-slate-900 border border-slate-800 text-slate-300'}">
                                <strong class="text-blue-400">A:</strong> ${escapeHTML(item.optionA)}
                            </div>
                            <div class="px-3 py-1.5 rounded-lg ${item.answer === 'B' ? 'bg-emerald-950/60 border border-emerald-500/40 text-emerald-200' : 'bg-slate-900 border border-slate-800 text-slate-300'}">
                                <strong class="text-amber-400">B:</strong> ${escapeHTML(item.optionB)}
                            </div>
                        </div>
                    </div>
                    <button type="button" onclick="deleteQuestion(${idx})" title="Hapus Soal" class="p-2 rounded-xl bg-slate-900 hover:bg-rose-600/20 text-slate-400 hover:text-rose-400 border border-slate-800 transition cursor-pointer shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                    </button>
                </div>
            `).join('');
        }

        function handleAddQuestion(e) {
            e.preventDefault();
            const q = document.getElementById('input-q').value.trim();
            const a = document.getElementById('input-a').value.trim();
            const b = document.getElementById('input-b').value.trim();
            const ans = document.getElementById('input-ans').value;

            if (!q || !a || !b) return;

            questions.push({ question: q, optionA: a, optionB: b, answer: ans });
            saveQuestionsToStorage();
            renderQuestionsList();

            document.getElementById('add-question-form').reset();
            showToast('Soal baru berhasil ditambahkan!', 'success');
        }

        function deleteQuestion(index) {
            questions.splice(index, 1);
            saveQuestionsToStorage();
            renderQuestionsList();
            showToast('Soal dihapus.', 'info');
        }

        function resetDefaultQuestions() {
            questions = [...DEFAULT_QUESTIONS];
            saveQuestionsToStorage();
            renderQuestionsList();
            showToast('Daftar soal dikembalikan ke soal bawaan.', 'success');
        }

        function escapeHTML(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        /**
         * 6. WEBRTC KAMERA & FULLSCREEN CONTROLLER
         */
        async function startCamera() {
            const videoEl = document.getElementById('webcam-video');
            const fallbackEl = document.getElementById('camera-fallback-bg');

            try {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }
                mediaStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: 'user',
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: false
                });
                videoEl.srcObject = mediaStream;
                videoEl.classList.remove('hidden');
                fallbackEl.classList.add('hidden');
                return true;
            } catch (err) {
                console.warn('Akses kamera ditolak atau tidak tersedia:', err);
                videoEl.classList.add('hidden');
                fallbackEl.classList.remove('hidden');
                showToast('Kamera tidak terdeteksi/ditolak. Berjalan dalam mode tampilan layar.', 'error');
                return false;
            }
        }

        function stopCamera() {
            if (mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
                mediaStream = null;
            }
            const videoEl = document.getElementById('webcam-video');
            videoEl.srcObject = null;
        }

        function enterFullscreen() {
            const elem = document.documentElement;
            if (elem.requestFullscreen) {
                elem.requestFullscreen().catch(() => {});
            } else if (elem.webkitRequestFullscreen) {
                elem.webkitRequestFullscreen();
            }
        }

        function exitFullscreen() {
            if (document.fullscreenElement || document.webkitFullscreenElement) {
                if (document.exitFullscreen) {
                    document.exitFullscreen().catch(() => {});
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                }
            }
        }

        /**
         * 7. STATE MACHINE GAMEPLAY (FASE 1 -> FASE 2 -> FASE 3)
         */
        async function startGame() {
            if (questions.length === 0) {
                showToast('Tambahkan minimal 1 soal terlebih dahulu!', 'error');
                return;
            }

            // Inisialisasi Web Audio API saat interaksi klik user
            initAudioContext();

            // Minta izin kamera & masuk mode fullscreen
            await startCamera();
            enterFullscreen();

            // Reset state game
            currentQuestionIndex = 0;
            
            // Transisi Layar
            document.getElementById('setup-screen').classList.add('hidden');
            document.getElementById('gameover-screen').classList.add('hidden');
            document.getElementById('gameplay-screen').classList.remove('hidden');

            startQuestionPhase();
        }

        // FASE 1: MEMILIH JAWABAN (TIMER BERJALAN)
        function startQuestionPhase() {
            clearTimers();
            gameState = 'CHOOSING';

            const currentQ = questions[currentQuestionIndex];
            timeLeft = durationPerQuestion;

            // Reset overlay & banner hasil dari soal sebelumnya
            const zoneA = document.getElementById('zone-overlay-a');
            const zoneB = document.getElementById('zone-overlay-b');
            zoneA.style.backgroundColor = 'transparent';
            zoneB.style.backgroundColor = 'transparent';

            document.getElementById('reveal-banner').classList.add('hidden');

            // Reset skala badge jawaban bawah
            document.getElementById('badge-option-a').classList.remove('scale-105', 'ring-4', 'ring-emerald-400', 'opacity-50');
            document.getElementById('badge-option-b').classList.remove('scale-105', 'ring-4', 'ring-emerald-400', 'opacity-50');

            // Update Teks Soal & Opsi
            document.getElementById('question-progress').textContent = `Soal ${currentQuestionIndex + 1}/${questions.length}`;
            document.getElementById('gameplay-question-text').textContent = currentQ.question;
            document.getElementById('gameplay-option-a').textContent = currentQ.optionA;
            document.getElementById('gameplay-option-b').textContent = currentQ.optionB;

            // Update Indikator Status Bar Hijau ("AKTIF")
            const statusBar = document.getElementById('status-bar');
            const statusDot = document.getElementById('status-dot');
            const statusText = document.getElementById('status-text');
            statusBar.className = 'px-6 py-2 sm:px-8 sm:py-3 rounded-full bg-emerald-600 border-2 border-emerald-300 shadow-[0_0_25px_rgba(16,185,129,0.7)] flex items-center gap-2.5 transition-all duration-300';
            statusDot.classList.remove('hidden');
            statusText.textContent = 'AKTIF';

            // Update Tampilan Timer Awal
            updateTimerUI();
            playTickSound(false);

            // Jalankan Interval Hitung Mundur
            countdownInterval = setInterval(() => {
                timeLeft--;
                updateTimerUI();

                if (timeLeft > 0) {
                    // Suara detak lebih cepat/tinggi saat sisa 3 detik terakhir
                    playTickSound(timeLeft <= 3);
                } else {
                    // Waktu Habis -> Masuk ke Fase 2 (Pengungkapan Jawaban)
                    clearInterval(countdownInterval);
                    startRevealPhase();
                }
            }, 1000);
        }

        function updateTimerUI() {
            const timerText = document.getElementById('timer-text');
            const timerCircle = document.getElementById('timer-circle');
            timerText.textContent = Math.max(0, timeLeft);

            if (timeLeft <= 3 && timeLeft > 0) {
                timerCircle.className = 'w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-rose-950/95 border-4 border-rose-500 shadow-[0_0_30px_rgba(244,63,94,0.8)] flex items-center justify-center animate-pulse-fast transition-colors duration-200';
                timerText.className = 'text-3xl sm:text-5xl font-black text-rose-300 tabular-nums';
            } else if (timeLeft === 0) {
                timerCircle.className = 'w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-slate-900 border-4 border-slate-500 flex items-center justify-center';
                timerText.className = 'text-3xl sm:text-5xl font-black text-slate-400 tabular-nums';
            } else {
                timerCircle.className = 'w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-slate-950/90 border-4 border-emerald-400 shadow-[0_8px_30px_rgba(0,0,0,0.7)] flex items-center justify-center transition-colors duration-300';
                timerText.className = 'text-3xl sm:text-5xl font-black text-white tabular-nums';
            }
        }

        // FASE 2: PENGUNGKAPAN JAWABAN (TIMER HABIS / 0 DETIK)
        function startRevealPhase() {
            gameState = 'REVEAL';
            const currentQ = questions[currentQuestionIndex];
            const correctAns = currentQ.answer; // 'A' atau 'B'

            // Mainkan efek suara lonceng / berhasil
            playRevealBellSound();

            // Ubah Status Bar menjadi "WAKTU HABIS"
            const statusBar = document.getElementById('status-bar');
            const statusDot = document.getElementById('status-dot');
            const statusText = document.getElementById('status-text');
            statusBar.className = 'px-6 py-2 sm:px-8 sm:py-3 rounded-full bg-rose-600 border-2 border-rose-300 shadow-[0_0_25px_rgba(225,29,72,0.7)] flex items-center gap-2.5 transition-all duration-300';
            statusDot.classList.add('hidden');
            statusText.textContent = 'WAKTU HABIS';

            // Belah layar menjadi dua overlay warna transparan (Hijau Benar, Merah Salah)
            const zoneA = document.getElementById('zone-overlay-a');
            const zoneB = document.getElementById('zone-overlay-b');
            const badgeA = document.getElementById('badge-option-a');
            const badgeB = document.getElementById('badge-option-b');

            if (correctAns === 'A') {
                zoneA.style.backgroundColor = 'rgba(0, 200, 0, 0.5)';
                zoneB.style.backgroundColor = 'rgba(220, 0, 0, 0.5)';
                badgeA.classList.add('scale-105', 'ring-4', 'ring-emerald-400');
                badgeB.classList.add('opacity-50');
            } else {
                zoneA.style.backgroundColor = 'rgba(220, 0, 0, 0.5)';
                zoneB.style.backgroundColor = 'rgba(0, 200, 0, 0.5)';
                badgeB.classList.add('scale-105', 'ring-4', 'ring-emerald-400');
                badgeA.classList.add('opacity-50');
            }

            // Tampilkan Teks Besar & Tebal di Tengah Layar: "JAWABAN: A" atau "JAWABAN: B"
            document.getElementById('reveal-answer-text').textContent = `JAWABAN: ${correctAns}`;
            document.getElementById('reveal-answer-desc').textContent = correctAns === 'A' ? currentQ.optionA : currentQ.optionB;
            document.getElementById('reveal-banner').classList.remove('hidden');

            // Tahan tampilan hasil selama 3.8 detik lalu otomatis lanjut ke soal berikutnya
            revealTimeout = setTimeout(() => {
                currentQuestionIndex++;
                if (currentQuestionIndex < questions.length) {
                    startQuestionPhase();
                } else {
                    startGameOverPhase();
                }
            }, 3800);
        }

        // FASE 3: LAYAR SELESAI (GAME OVER / PEMENANG)
        function startGameOverPhase() {
            clearTimers();
            gameState = 'GAMEOVER';
            playVictoryFanfare();

            document.getElementById('gameplay-screen').classList.add('hidden');
            document.getElementById('gameover-screen').classList.remove('hidden');
        }

        function restartGame() {
            document.getElementById('gameover-screen').classList.add('hidden');
            document.getElementById('gameplay-screen').classList.remove('hidden');
            currentQuestionIndex = 0;
            startQuestionPhase();
        }

        function exitToSetup() {
            clearTimers();
            stopCamera();
            exitFullscreen();
            gameState = 'SETUP';

            document.getElementById('gameplay-screen').classList.add('hidden');
            document.getElementById('gameover-screen').classList.add('hidden');
            document.getElementById('setup-screen').classList.remove('hidden');
        }

        function clearTimers() {
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }
            if (revealTimeout) {
                clearTimeout(revealTimeout);
                revealTimeout = null;
            }
        }

        // Inisialisasi awal saat halaman dimuat
        window.addEventListener('DOMContentLoaded', () => {
            renderQuestionsList();
            setTimerPreset(10);
        });
    </script>
